{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "types": [
      "node",
      "jest"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "better-sqlite3": [
        "./node_modules/@types/better-sqlite3"
      ],
      "@amiexpress/bbs-door-sdk/settings": [
        "../../sdk/core/settings"
      ],
      "@amiexpress/terminal/utils/key-overrides": [
        "../../packages/terminal/src/utils/key-overrides"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}
