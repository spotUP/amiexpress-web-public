{
  "name": "pengo",
  "category": "game",
  "version": "1.0.0",
  "description": "Pengo arcade game - 1982 Sega classic ice block puzzle",
  "main": "dist/index.js",
  "bbsCommand": "PENGO",
  "doorType": "TS",
  "runtime": "hybrid",
  "client": {
    "entry": "./client.ts",
    "bundle": "./dist/client.bundle.js"
  },
  "server": {
    "entry": "./index.ts"
  },
  "accessLevel": 0,
  "author": "AmiExpress BBS",
  "scripts": {
    "build": "tsc && npm run bundle:client && npm run copy-sprites",
    "bundle:client": "esbuild client.ts --bundle --outfile=dist/client.bundle.js --format=esm --target=es2020 --platform=browser --external:fs --external:path --external:child_process",
    "copy-sprites": "mkdir -p dist/sprites && cp sprites/*.sprite.json dist/sprites/",
    "watch": "tsc --watch",
    "test": "tsx tests/run-tests.ts"
  },
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.2.2"
  },
  "amiexpress": {
    "command": "pengo",
    "achievements": [
      {
        "id": "door.pengo.first_game",
        "name": "Cold Open",
        "description": "Play a game of PENGO",
        "family": "door.pengo",
        "tier": "bronze",
        "points": 5,
        "hidden": false,
        "rule": {
          "op": "first",
          "type": "door.pengo.game"
        }
      },
      {
        "id": "door.pengo.games_50",
        "name": "Rink Regular",
        "description": "Play fifty games of PENGO",
        "family": "door.pengo",
        "tier": "silver",
        "points": 10,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.pengo.game",
          "n": 50
        }
      },
      {
        "id": "door.pengo.level_5",
        "name": "Fifth Floe",
        "description": "Reach level five in PENGO",
        "family": "door.pengo",
        "tier": "silver",
        "points": 10,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.pengo.level",
          "key": "5",
          "n": 1
        }
      },
      {
        "id": "door.pengo.level_10",
        "name": "Deep Freeze",
        "description": "Reach level ten in PENGO",
        "family": "door.pengo",
        "tier": "gold",
        "points": 25,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.pengo.level",
          "key": "10",
          "n": 1
        }
      }
    ]
  }
}
