{
  "name": "super-qix",
  "category": "game",
  "version": "1.0.0",
  "description": "Super Qix arcade game - 1987 Taito classic",
  "main": "dist/index.js",
  "bbsCommand": "SUPERQIX",
  "doorType": "TS",
  "runtime": "hybrid",
  "client": {
    "entry": "./client.ts",
    "bundle": "./dist/client.bundle.js"
  },
  "server": {
    "entry": "./index.ts"
  },
  "accessLevel": 0,
  "author": "AmiExpress BBS",
  "scripts": {
    "build": "tsc && npm run bundle:client",
    "bundle:client": "esbuild client.ts --bundle --outfile=dist/client.bundle.js --format=esm --target=es2020 --platform=browser --external:fs --external:path --external:child_process",
    "watch": "tsc --watch",
    "test": "tsx tests/run-tests.ts"
  },
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.2.2"
  },
  "amiexpress": {
    "command": "superqix",
    "achievements": [
      {
        "id": "door.superqix.first_game",
        "name": "First Claim",
        "description": "Play a game of SUPERQIX",
        "family": "door.superqix",
        "tier": "bronze",
        "points": 5,
        "hidden": false,
        "rule": {
          "op": "first",
          "type": "door.superqix.game"
        }
      },
      {
        "id": "door.superqix.games_50",
        "name": "Field Worker",
        "description": "Play fifty games of SUPERQIX",
        "family": "door.superqix",
        "tier": "silver",
        "points": 10,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.superqix.game",
          "n": 50
        }
      },
      {
        "id": "door.superqix.level_4",
        "name": "Four Squares",
        "description": "Reach level four in SUPERQIX",
        "family": "door.superqix",
        "tier": "silver",
        "points": 10,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.superqix.level",
          "key": "4",
          "n": 1
        }
      },
      {
        "id": "door.superqix.level_10",
        "name": "Ten Deep",
        "description": "Reach level ten in SUPERQIX",
        "family": "door.superqix",
        "tier": "gold",
        "points": 25,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.superqix.level",
          "key": "10",
          "n": 1
        }
      }
    ]
  }
}
