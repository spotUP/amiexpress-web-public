# Dependencies
# No trailing slash: with one, these match DIRECTORIES only, and a SYMLINK
# named node_modules slips past. Two of them were committed on 2026-09-01
# (web/backend/node_modules and Doors/grandmaster/node_modules, both pointing
# into one developer's home directory) and every deploy failed from then on -
# the image builds a real node_modules with npm ci, and COPY cannot replace a
# directory with a symlink.
node_modules
backend/node_modules
board/Doors/*/node_modules

# Build outputs
dist/
backend/dist/
.vite/
# But keep door dist folders - needed for Docker builds
!board/Doors/*/dist/

# TypeScript build artifacts in source directories
web/backend/src/**/*.js
web/backend/src/**/*.d.ts
!web/backend/src/types/*.d.ts
web/backend/src/**/*.d.ts.map
web/backend/src/**/*.js.map
web/config-app/src/**/*.js
web/config-app/src/**/*.d.ts
# vite-env.d.ts is SOURCE, not a build artefact: without it TypeScript does
# not know import.meta.env and the app does not compile. web/frontend commits
# its own copy for the same reason.
!web/config-app/src/vite-env.d.ts
sdk/dist-esm/**/*.map
!web/backend/src/**/*.config.js
!web/backend/src/**/*.setup.js

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
.env.production
.env.staging
.sdk-preview.env


