[Unit]
Description=Check origin/main for a new commit to deploy
# Without Actions there is nothing else watching: this is what makes a push
# reach the board.
Documentation=file:/app/amiexpress/deploy/watch-main.sh

[Timer]
# Two minutes after boot, then every two minutes. The check is a git fetch and
# a curl; the expensive half only runs when the sha has actually moved.
OnBootSec=2min
OnUnitActiveSec=2min
# A missed window (the box was off) runs once on the next start rather than
# catching up repeatedly.
Persistent=true
AccuracySec=30s
Unit=amiexpress-deploy.service

[Install]
WantedBy=timers.target
