# /etc/systemd/system/bbs-backup.timer
[Unit]
Description=Run the AmiExpress BBS snapshot nightly

[Timer]
# 04:17 UTC keeps clear of certbot (04:39) and the apt-daily hours, and the
# board is quiet.
OnCalendar=*-*-* 04:17:00 UTC
Persistent=true
RandomizedDelaySec=300
Unit=bbs-backup.service

[Install]
WantedBy=timers.target
