#!/bin/sh
# /etc/update-motd.d/98-bbs-backup - print the backup alarm on every ssh login.
# The loudest channel this host has without a mail transport or a credential.
DEST=/var/backups/bbs
if [ -f "$DEST/ALERT" ]; then
    printf '\n'
    printf '  ****************************************************************\n'
    printf '  *  [ERROR] BBS BACKUP ALERT - the nightly snapshot is broken   *\n'
    printf '  ****************************************************************\n'
    sed -n '2,3p' "$DEST/ALERT" | sed 's/^/  /'
    printf '  Full detail: cat %s/ALERT\n' "$DEST"
    printf '  Log:         tail -40 %s/bbs-backup.log\n' "$DEST"
    printf '  Retry:       systemctl start bbs-backup.service\n\n'
else
    latest=$(ls -1d "$DEST"/20*/ 2>/dev/null | sort | tail -1)
    if [ -n "$latest" ]; then
        printf '  BBS backup: %s (%s)\n' "$(basename "$latest")" "$(du -sh "$latest" 2>/dev/null | cut -f1)"
    fi
fi
