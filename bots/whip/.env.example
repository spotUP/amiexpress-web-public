# Copy to .env and fill in. Never commit .env.
# Discord application bot token (https://discord.com/developers/applications).
DISCORD_BOT_TOKEN=
# Guild where slash commands are registered (fast guild-scoped registration).
DISCORD_GUILD_ID=
# Backend base URL the bot verifies link codes against (Phase 1+: REST + socket).
WHIP_API_URL=http://localhost:3001
# Shared secret matching the backend's WHIP_SERVICE_TOKEN.
WHIP_SERVICE_TOKEN=
# Bridge BBS account the live feed socket logs in with (POST /api/chat/login).
WHIP_BBS_USER=
WHIP_BBS_PASSWORD=
# Channel the live WHIP feed posts to. Optional: feed stays silent when unset.
DISCORD_FEED_CHANNEL_ID=
# Health endpoint port (compose healthcheck + admin status probe).
HEALTH_PORT=3099
