# TEXTTV - SVT Text-TV client config.
# Missing file is defaults, not an error: the door fetches /api/texttv
# from the board's backend over plain HTTP (api.texttv.nu is HTTPS-only
# and the 68K stack cannot do TLS). Loopback: the door runs beside the
# board - a public hostname hairpins from inside the container and stalls
# every page turn. Point Host at the LAN IP for a classic Amiga.
Host=127.0.0.1
Port=3001
Timeout=15
StartPage=100
Favorites=100,300
