# Copy this file to GROUPS.MAP and edit it.
#
# One rule per line: a filename glob, `=`, and the group name.
# First match wins, top to bottom. Matching ignores case.
# A rule here beats anything the board worked out for itself.
#
# filename glob = group name
OTL-*    = Outlaws
FLT-*    = Fairlight
PDX*     = Paradox
LSD*     = LSD
TRSI-*   = TRSI
