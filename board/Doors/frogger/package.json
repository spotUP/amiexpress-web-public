{
  "name": "frogger",
  "category": "game",
  "version": "1.0.0",
  "description": "Frogger arcade game - 1981 Konami classic",
  "main": "dist/index.js",
  "bbsCommand": "FROGGER",
  "doorType": "TS",
  "runtime": "hybrid",
  "client": {
    "entry": "./client.ts",
    "bundle": "./dist/client.bundle.js"
  },
  "server": {
    "entry": "./index.ts"
  },
  "accessLevel": 0,
  "author": "AmiExpress BBS",
  "scripts": {
    "build": "tsc && npm run bundle:client && npm run copy-sprites",
    "bundle:client": "esbuild client.ts --bundle --outfile=dist/client.bundle.js --format=esm --target=es2020 --platform=browser --external:fs --external:path --external:child_process",
    "watch": "tsc --watch",
    "test": "tsx tests/run-tests.ts",
    "copy-sprites": "mkdir -p dist/sprites && cp sprites/*.sprite.json dist/sprites/"
  },
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../../sdk"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.2.2"
  },
  "amiexpress": {
    "command": "frogger",
    "achievements": [
      {
        "id": "door.frogger.first_game",
        "name": "First Hop",
        "description": "Play a game of FROGGER",
        "family": "door.frogger",
        "tier": "bronze",
        "points": 5,
        "hidden": false,
        "rule": {
          "op": "first",
          "type": "door.frogger.game"
        }
      },
      {
        "id": "door.frogger.games_50",
        "name": "Roadside Regular",
        "description": "Play fifty games of FROGGER",
        "family": "door.frogger",
        "tier": "silver",
        "points": 10,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.frogger.game",
          "n": 50
        }
      },
      {
        "id": "door.frogger.level_3",
        "name": "Third Crossing",
        "description": "Reach level three in FROGGER",
        "family": "door.frogger",
        "tier": "silver",
        "points": 10,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.frogger.level",
          "key": "3",
          "n": 1
        }
      },
      {
        "id": "door.frogger.level_8",
        "name": "Home Free",
        "description": "Reach level eight in FROGGER",
        "family": "door.frogger",
        "tier": "gold",
        "points": 25,
        "hidden": false,
        "rule": {
          "op": "count",
          "type": "door.frogger.level",
          "key": "8",
          "n": 1
        }
      }
    ]
  }
}
