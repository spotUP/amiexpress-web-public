{
  "name": "@amiexpress/grandmaster",
  "version": "1.0.0",
  "description": "GRANDMASTER - TGM3-Inspired Multiplayer Tetris for BBS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "runtime": "hybrid",
  "capturePointer": true,
  "client": {
    "entry": "./client.ts",
    "bundle": "./dist/client.bundle.js"
  },
  "server": {
    "entry": "./index.ts"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets && npm run copy-sprites && npm run copy-patterns && npm run copy-puzzles && npm run bundle:client",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "copy-assets": "mkdir -p dist/server/database && cp server/database/schema.sql dist/server/database/",
    "bundle:client": "esbuild client.ts --bundle --outfile=dist/client.bundle.js --format=iife --platform=browser --target=es2020 --minify --external:fs --external:path --external:net --external:child_process --external:crypto",
    "test": "tsx tests/run-tests.ts",
    "copy-sprites": "mkdir -p dist/sprites && cp sprites/*.sprite.json dist/sprites/",
    "copy-patterns": "mkdir -p dist/attack-patterns && cp attack-patterns/*.json dist/attack-patterns/",
    "copy-puzzles": "mkdir -p dist/puzzles && cp puzzles/*.json dist/puzzles/"
  },
  "keywords": [
    "tetris",
    "tgm3",
    "bbs",
    "door",
    "multiplayer",
    "grandmaster"
  ],
  "author": "AmiExpress",
  "license": "MIT",
  "dependencies": {
    "@amiexpress/bbs-door-sdk": "file:../../sdk",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.5.0",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  },
  "door": {
    "name": "GRANDMASTER",
    "command": "GMASTER",
    "aliases": [
      "GRANDMASTER",
      "TETRIS",
      "TGM"
    ],
    "description": "TGM3-inspired multiplayer Tetris with 20G gravity, full grading system, and real-time versus modes",
    "category": "Games",
    "minPlayers": 1,
    "maxPlayers": 64,
    "version": "1.0.0",
    "runtime": "hybrid",
    "achievements": [
      {
        "id": "door.gmaster.first_game",
        "name": "First Drop",
        "description": "Finish a game of GRANDMASTER",
        "tier": "bronze",
        "points": 5,
        "rule": {
          "op": "first",
          "type": "door.gmaster.game"
        }
      },
      {
        "id": "door.gmaster.games_100",
        "name": "Hundred Games",
        "description": "Finish a hundred games of GRANDMASTER",
        "tier": "silver",
        "points": 10,
        "rule": {
          "op": "count",
          "type": "door.gmaster.game",
          "n": 100
        }
      },
      {
        "id": "door.gmaster.every_mode",
        "name": "All Comers",
        "description": "Finish a game in five different GRANDMASTER modes",
        "tier": "gold",
        "points": 25,
        "rule": {
          "op": "distinct",
          "type": "door.gmaster.game",
          "dim": "key",
          "n": 5
        }
      },
      {
        "id": "door.gmaster.grade_s",
        "name": "Graded",
        "description": "Reach an S grade",
        "tier": "gold",
        "points": 25,
        "rule": {
          "op": "count",
          "type": "door.gmaster.grade",
          "key": "s",
          "n": 1
        }
      },
      {
        "id": "door.gmaster.million",
        "name": "Seven Figures",
        "description": "Score a million points in one game",
        "tier": "platinum",
        "points": 50,
        "hidden": true,
        "rule": {
          "op": "count",
          "type": "door.gmaster.big_score",
          "key": "1m",
          "n": 1
        }
      }
    ]
  }
}
