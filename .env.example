# AmiExpress Web Environment Variables
# Copy this file to .env and fill in what you need; every value is optional.
# docker-compose.yml loads .env and then .env.local (both ignored by git).

# ============================================
# DATABASE CONFIGURATION (SQLite)
# ============================================

# SQLite database directory (defaults to ./data if not set)
DATABASE_DIR=./data

# SQLite database filename (defaults to amiexpress.db if not set)
DATABASE_FILE=amiexpress.db

# Full SQLite database path (alternative to separate dir/file)
# DATABASE_URL=./data/amiexpress.db

# ============================================
# BBS ROOT DIRECTORY (File System Root)
# ============================================

# BBS root directory - root path for all BBS files
# This is the base path for doors/, Commands/, BBS/ directories
#
# For Docker: /app (set in docker-compose.yml)
# For local development: defaults to project root (leave empty)
#
# Example structure at BBS_ROOT:
#   - Doors/           - Installed door programs
#   - Commands/BBSCmd/ - BBS command definitions (.info files)
#   - Commands/SysCmd/ - Sysop command definitions (.info files)
#   - Screens/         - Display screens
#   - Conf##/          - Conference-specific files
#
# BBS_ROOT=/app   (Docker only: docker-compose.yml sets it; a local run must leave it unset)

# ============================================
# BBS DATA DIRECTORY (Persistent Storage)
# ============================================

# BBS data directory - contains all BBS content
# Structure created within this directory:
#   - Doors/           - Door programs and archives
#   - Node0/Playpen/   - User file uploads (staging)
#   - BBS/Conf##/Files/ - File areas per conference
#   - BBS/Screens/     - Display screens
#   - BBS/Commands/    - Command definitions
#
# For Docker: /app/data/bbs (mounted persistent volume)
# For local development: defaults to project root
# BBS_DATA_DIR=/app/data/bbs   (Docker only; start-servers.sh sets it locally)

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# JWT Secrets for authentication
# Generate with: openssl rand -base64 64
# Docker: leave these unset (or CHANGE_ME) and the container generates strong
# values on first start and keeps them in /app/data/.secrets. A value set here
# always wins. A placeholder (CHANGE_ME, your_*_here) is refused in production.
# Local development (NODE_ENV=development) works without them.
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# Session Secret for cookie signing
# Generate with: openssl rand -base64 64
# Same rule as JWT_SECRET: unset in Docker means generated.
# SESSION_SECRET=

# Service token for the WHIP Discord mirror bot (bots/whip)
# Generate with: openssl rand -base64 32
# REQUIRED on the backend when the bot is used; the bot sends it as a
# Bearer token on /api/whip/*. Empty (or a placeholder) means the bot
# gets 401 everywhere.
WHIP_SERVICE_TOKEN=

# Per-bot read tokens for the chatbot data API (GET /api/bot/v1/*).
# Format: "botid:secret,other:secret2:whip+board" - comma pairs of id and
# secret with an optional third segment of +-separated read domains
# (board, users, messages, files, conferences, whip, doors, activity).
# Generate each secret with: openssl rand -base64 32
# Absent means every /api/bot/v1 route answers 401.
BOT_DATA_TOKENS=

# OpenCode Zen key for the co-sysop cascade (https://opencode.ai/docs/zen).
# Set it here or in /admin operator-chat settings; the cascade tries the
# preferred provider first, then Zen, Go, OpenRouter, Groq, Gemini.
ZEN_API_KEY=

# OpenCode Go key for the co-sysop cascade (https://opencode.ai/docs/go).
# Same shape as Zen (OpenAI-compatible); tried right after Zen.
GO_API_KEY=

# Cerebras key for the co-sysop cascade (https://cloud.cerebras.ai).
# Free tier, no card. Plain completions, no tool loop; last resort leg.
CEREBRAS_API_KEY=

# ============================================
# SECURITY CONFIGURATION
# ============================================

# Origins allowed to call the API and open the WebSocket, comma separated.
# Set this to your board's public URL in production.
# Example: https://yourbbs.example.com,https://www.yourbbs.example.com
# Leave empty for the built-in list (localhost dev ports and the uprough.net
# hosts, web/backend/src/config.ts).
CORS_ORIGINS=

# ============================================
# OPERATOR CHAT AI BOT (Multi-Tier Free AI)
# ============================================

# The grumpy sysop chatbot uses a multi-tier fallback system with ALL FREE APIs:
#   Tier 1: Groq (fastest, Llama 3.1, 14,400 requests/day)
#   Tier 2: Google Gemini (best quality, 60 requests/min)
#   Tier 3: OpenRouter (auto-discovered free models)
#   Tier 4: Rule-based responses (200+ grumpy responses)
#
# ALL API keys are OPTIONAL - bot works without them!
# It will skip tiers without keys and fall back to the next tier.
# Even with no keys, the rule-based system provides full functionality.

# Groq API Key (OPTIONAL - Free tier, fastest responses)
# Get from: https://console.groq.com/keys
# Free: 14,400 requests/day with Llama 3.1 8B Instant
GROQ_API_KEY=

# Google Gemini API Key (OPTIONAL - Free tier, best quality)
# Get from: https://aistudio.google.com/app/apikey
# Free: 60 requests/minute for Gemini 1.5 Flash, no credit card required
GEMINI_API_KEY=

# OpenRouter (OPTIONAL - Auto-discovers free models)
# API key is REQUIRED even for free models!
# Get from: https://openrouter.ai/keys
# Automatically finds free models from public API.
# Falls back to rule-based responses if no free models are available.
OPENROUTER_API_KEY=

# Node Environment (local dev; the Docker image sets production itself)
NODE_ENV=development

# ============================================
# DOCKER COMPOSE (all optional, neutral defaults)
# ============================================

# Board time zone (default UTC), e.g. Europe/Stockholm
# BBS_TIMEZONE=UTC

# FTP passive mode: the PUBLIC IP callers must dial. Unset: PASV answers 425.
# FTP_PASSIVE_ADDRESS=

# FTPS: host directory holding <name>.crt / <name>.key, mounted at /certs.
# Unset: FTPS is off and FTP refuses plaintext logins from off the box.
# FTP_TLS_DIR=./ftp-certs
# FTP_TLS_CERT=/certs/yourbbs.example.com.crt
# FTP_TLS_KEY=/certs/yourbbs.example.com.key
# FTP_TLS_HOSTS=yourbbs.example.com

# Door server (separate stack). Unset: the door-repo paths 404.
# DOOR_SERVER_URL=http://doorserver:3010

# ============================================
# DEPLOYMENT NOTIFICATIONS (Optional)
# ============================================

# Deployment Webhook URL (Discord or Slack)
# Get from: Discord (Server Settings > Integrations > Webhooks)
#           Slack (Incoming Webhooks app)
# Leave empty to disable deployment notifications
DEPLOY_WEBHOOK_URL=

# Example Discord:
# DEPLOY_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefghijklmnop

# Example Slack:
# DEPLOY_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX

# ============================================
# WEB PUSH NOTIFICATIONS (VAPID Keys)
# ============================================

# VAPID keys for Web Push notifications (operator page alerts)
# Generate with: npx web-push generate-vapid-keys --json
# Leave empty to disable push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact email for VAPID (required if using push notifications)
VAPID_CONTACT_EMAIL=mailto:admin@example.com

# ============================================
# DEVELOPMENT VARIABLES (Optional)
# ============================================

# Development database location
# DATABASE_DIR=./data
# DATABASE_FILE=amiexpress-dev.db

# Development server ports
BACKEND_PORT=3001
FRONTEND_PORT=5173

# BBS server ports (telnet and SSH)
# Defaults match LISTENER_DEFAULTS in web/backend/src/server/board-listeners.ts
# and docker-compose.yml.
TELNET_PORT=64128
SSH_PORT=31337

# SDK preview backend port (server.js, vite proxy, CORS, kill-servers.sh)
SDK_PREVIEW_PORT=8080

# SSH host key management
# SSH keys are automatically stored in data/ssh/ssh_host_rsa_key
# Generate keys via the admin configuration portal at http://localhost:3001/admin/
# Or manually with: ssh-keygen -t rsa -b 4096 -f data/ssh/ssh_host_rsa_key -N ""
# Note: SSH_HOST_KEY_PATH is deprecated - keys are now managed through the admin portal

# ============================================
# DEBUG OPTIONS (Development Only)
# ============================================

# Backend log level: debug | info | warn | error
# Default: debug when NODE_ENV=development, info otherwise.
# console.log / console.debug are debug level, console.info is info level,
# console.warn / console.error always print. Suppressed lines are also kept
# out of logs/backend.log. Sysop-relevant lines (startup, database, login,
# door start/exit) are console.info so a production board still shows them.
# LOG_LEVEL=info

# 68K emulator trace (DoorLogger files, per-trap console output)
# Set to "1" or "true" to enable
# DEBUG_68K=1

# XIM Protocol Debug Logging
# Enable detailed logging of all XIM protocol messages between BBS and doors
# Logs to: logs/xim-debug.log
# Set to "1" or "true" to enable
# XIM_DEBUG=1

