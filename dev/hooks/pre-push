#!/usr/bin/env bash
#
# The gate that has to exist because CI does not.
#
# GitHub Actions is unpaid on this repo: `gh run list` answers HTTP 404, so
# `backend-tests.yml` has never run a single time. `deploy/deploy.sh` runs no
# tests either - deliberately, because nothing guarantees a node on the host
# outside the container - and there is no branch protection. So between a
# commit and the live board there was nothing at all, and it showed: four test
# assertions sat red on `main` and on the live board for days, one of them a
# real regression that hid an artist's own screens from them.
#
# This runs the cheap, high-signal half: both type-checks and the repo-rule
# scans that are pure file reads. Together about 25 seconds. It deliberately
# does NOT run the full backend suite (12,000+ tests) - a gate slow enough to
# be resented is a gate that gets --no-verify'd, and the full suite is
# `npm test`.
#
# Skip deliberately with:  git push --no-verify
set -uo pipefail

# THE TREE BEING PUSHED, not the tree this file happens to live in.
#
# `BASH_SOURCE` resolves to the shared checkout for every worktree, because
# worktrees run hooks out of the shared `.git/hooks`. So this gate used to
# type-check ~/Code/AmiExpress/amiexpress-web whatever you were pushing from:
# a clean worktree was refused because somebody else's uncommitted file in
# the shared tree was red, and the push it was actually inspecting was never
# looked at. Reported 2026-09-13 by a session whose worktree was green and
# whose push was blocked anyway.
#
# `--show-toplevel` is the worktree git invoked us in, which is the one whose
# commits are going out.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$REPO_ROOT" ] || exit 0
cd "$REPO_ROOT" || exit 0

# THE COMMIT BEING PUSHED, not the files lying about in the tree.
#
# This gate used to type-check the WORKING TREE, which is not what leaves the
# machine. On 2026-09-18 that let a broken line reach `main`: the commit
# carried an unused parameter (TS6133), the working copy beside it had been
# corrected, and the gate went green on the correction while pushing the
# fault. The tree is also where OTHER sessions' half-finished files live, so
# the old behaviour refused clean pushes for dirt that was never going out.
#
# So: check out the pushed commit into a throwaway worktree, sparse to the
# three directories the type-checks read, borrow this checkout's node_modules
# and run the steps there. Removed in a trap, whatever happens.
#
# Falls back to the working tree - LOUDLY - if any of that cannot be done. A
# gate that dies on its own machinery teaches people to reach for
# --no-verify, which costs more than the gate is worth.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

PUSHED_SHA=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    ""|0000000000000000000000000000000000000000) continue ;;   # a branch deletion
  esac
  PUSHED_SHA="$local_sha"
done

CHECK_ROOT="$REPO_ROOT"
SCRATCH=""
cleanup() {
  [ -n "$SCRATCH" ] || return 0
  git -C "$REPO_ROOT" worktree remove --force "$SCRATCH" >/dev/null 2>&1 || rm -rf "$SCRATCH"
  git -C "$REPO_ROOT" worktree prune >/dev/null 2>&1
}
trap cleanup EXIT

if [ -n "$PUSHED_SHA" ]; then
  SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-XXXXXX")" || SCRATCH=""
fi

if [ -n "$SCRATCH" ] && git -C "$REPO_ROOT" worktree add --detach --no-checkout "$SCRATCH" "$PUSHED_SHA" >/dev/null 2>&1; then
  # Only what the type-checks read. The board's own directories - Conf, Doors,
  # Node<n> - are thousands of files this never opens. The backend tests
  # import door and dev-script sources, so their .ts/.json come along; door
  # binaries and art do not.
  if git -C "$SCRATCH" sparse-checkout set --no-cone web sdk packages \
       '/Doors/**/*.ts' '/Doors/**/*.json' '/dev/**/*.ts' '/dev/**/*.json' >/dev/null 2>&1 \
     && git -C "$SCRATCH" checkout --quiet >/dev/null 2>&1; then
    # tsc needs the toolchain, and a fresh worktree has none. Borrowed, not
    # installed: an install here would cost minutes and a gigabyte.
    for dir in . web/backend web/config-app packages/terminal sdk $(cd "$REPO_ROOT" && ls -d Doors/*/node_modules 2>/dev/null | sed 's:/node_modules$::'); do
      if [ -d "$REPO_ROOT/$dir/node_modules" ] && [ ! -e "$SCRATCH/$dir/node_modules" ]; then
        mkdir -p "$SCRATCH/$dir" 2>/dev/null
        ln -s "$REPO_ROOT/$dir/node_modules" "$SCRATCH/$dir/node_modules" 2>/dev/null
      fi
    done
    CHECK_ROOT="$SCRATCH"
    echo "[pre-push] checking the COMMIT ${PUSHED_SHA:0:9}, not the working tree"
  else
    echo "[pre-push] WARNING: could not lay out ${PUSHED_SHA:0:9}; checking the WORKING TREE instead"
  fi
elif [ -n "$PUSHED_SHA" ]; then
  echo "[pre-push] WARNING: no throwaway worktree available; checking the WORKING TREE instead"
fi

cd "$CHECK_ROOT" || exit 0

FAILED=""
SKIPPED=""

step() {
  local name="$1"; shift
  printf '[pre-push] %s ... ' "$name"
  local output
  if output=$("$@" 2>&1); then
    echo "[OK]"
  else
    echo "[FAIL]"
    echo "$output" | tail -25
    FAILED="$FAILED $name"
  fi
}

run_in() { (cd "$1" && shift && "$@"); }

# A check that CANNOT RUN is not a check that FAILED.
#
# The landing model here is a throwaway worktree cut from origin/main, and a
# worktree has no node_modules - so tsc reports "Cannot find type definition
# file for 'node'" and every step went red at once. Refusing a push because
# the toolchain is absent teaches people to reach for --no-verify, which
# costs more than the gate is worth. Skip loudly instead, and say which tree
# was not checked so nobody reads silence as approval.
have_deps() { [ -d "$1/node_modules" ]; }

if have_deps web/backend; then
  step "backend types"  run_in web/backend    npx tsc --noEmit -p tsconfig.json
  # jest does not type-check the tests, so nothing else stops them drifting
  # from the code: 79 errors had piled up unseen by 2026-10-12.
  step "backend test types" run_in web/backend npx tsc --noEmit -p tsconfig.tests.json
  # The test program reads door sources, which resolve imports from each
  # door's own node_modules. A fresh clone has none, and the errors that
  # causes look like a broken commit. Name the doors that are missing.
  case "$FAILED" in
    *"backend test types"*)
      "$REPO_ROOT/dev/scripts/install-door-deps.sh" --check 2>/dev/null | sed 's/^/[pre-push] /' ;;
  esac
else
  echo "[pre-push] backend types ... [SKIPPED] no node_modules in $CHECK_ROOT/web/backend"
  SKIPPED=yes
fi

if have_deps web/config-app; then
  step "admin types"    run_in web/config-app npx tsc --noEmit
  step "admin design system" run_in web/config-app npx vitest run --reporter=basic \
    src/test/design-system-usage.test.ts \
    src/test/tailwind-tokens.test.ts \
    src/test/modal-semantics.test.tsx
else
  echo "[pre-push] admin checks ... [SKIPPED] no node_modules in $CHECK_ROOT/web/config-app"
  SKIPPED=yes
fi

if [ -n "$FAILED" ]; then
  echo
  echo "[pre-push] REFUSED:$FAILED"
  echo "[pre-push] Fix it, or push with --no-verify if you mean to."
  exit 1
fi

if [ -n "$SKIPPED" ]; then
  echo "[pre-push] [OK] pushing - but some checks could not run here; run them where the deps are"
  exit 0
fi

echo "[pre-push] [OK] pushing"
exit 0
